Package: kernelsynth
Type: Package
Title: Diverse Synthetic Time Series from Random Gaussian Process Kernel Compositions
Version: 0.1.0
Authors@R: c(
    person("T.", "Moudiki", email = "thierry.moudiki@gmail.com",
